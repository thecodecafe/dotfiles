;; Caps Lock: tap Escape, hold Control, double-tap and hold Hyper.
;; Hyper+H/J/K/L sends the arrow keys.

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
  ;; This mouse also advertises a keyboard interface; leave it to macOS.
  macos-dev-names-exclude (
    "MX Master 2S"
  )
)

(defsrc caps h j k l)

(defalias
  hyper (multi (layer-while-held hyper) lctl lalt lmet lsft)
  ;; Resolve holds first; a completed tap starts the double-tap window.
  ;; Zero tap-repress timeouts let every hold resolve to its modifier.
  caps (tap-hold-press 0 150
    (tap-dance 100 (
      esc
      (tap-hold-press 0 150 esc @hyper)
    ))
    lctl
  )
)

(deflayer base
  @caps h j k l
)

(deflayer hyper
  ;; Hyper stays held for other shortcuts, but navigation sends plain arrows.
  _ (unmod left) (unmod down) (unmod up) (unmod right)
)
